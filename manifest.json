{
    "manifest_version": 3,
    "name": "Zekas Reward Claim",
    "version": "2.5.1",
    "author": "Zekas",
    "description": "Zekas Reward Claim - Tiện ích cày Bing Rewards tự động độc quyền: PC + Mobile, Daily Set, Bypass SSO Passkey, chống rò rỉ WebRTC và bảo mật ngoại tuyến 100%.",
    "permissions": [
        "tabs",
        "storage",
        "scripting",
        "declarativeNetRequest",
        "browsingData",
        "cookies",
        "search",
        "alarms",
        "notifications",
        "privacy"
    ],
    "host_permissions": [
        "*://*.bing.com/*",
        "*://login.live.com/*",
        "*://login.microsoftonline.com/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "icons/icon16.png",
            "48": "icons/icon48.png",
            "128": "icons/icon128.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icons/icon16.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png"
    }
}